[Unit]
Description=Cogito drift daemon (three-process mode)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/cogito
Environment=COGITO_PROJECT_DIR=%h/projects/cogito
Environment=PI_AGENT_DIR=%h/.cogito/agent
EnvironmentFile=%h/.config/cogito/gateway.env
ExecStart=/usr/bin/env node --import tsx packages/drift/scripts/daemon.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
KillSignal=SIGTERM
UMask=0077

[Install]
WantedBy=default.target
